# MongoDB
MONGODB_URI=mongodb://localhost:27017/inventory

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
# Optional: Path or PEM content of CA certificate for TLS
ELASTICSEARCH_TLS_CA=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Set to "true" to enable TLS for Redis connection
REDIS_TLS=false

# Sync schedule (cron expression — default: every 10 minutes)
SYNC_INTERVAL_CRON=*/10 * * * *

# Documents fetched per batch per collection
SYNC_BATCH_SIZE=500

# RAG phase 2 switch
RAG_PHASE2_ENABLED=true

# Embedding model + API (HuggingFace feature extraction endpoint)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_API_URL=https://api-inference.huggingface.co/pipeline/feature-extraction/sentence-transformers/all-MiniLM-L6-v2
HUGGINGFACE_API_KEY=
EMBEDDING_TIMEOUT_MS=10000
EMBEDDING_CACHE_TTL_SECONDS=86400
EMBEDDING_VECTOR_DIMS=384

# Markdown knowledge root (default resolves to ../../../01_Documents)
RAG_MARKDOWN_ROOT_DIR=
