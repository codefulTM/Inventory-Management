# MongoDB
MONGODB_URI=mongodb://localhost:27017/inventory

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
# Optional: Path or PEM content of CA certificate for TLS
ELASTICSEARCH_TLS_CA=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Set to "true" to enable TLS for Redis connection
REDIS_TLS=false

# Sync schedule (cron expression — default: every 10 minutes)
SYNC_INTERVAL_CRON=*/10 * * * *

# Documents fetched per batch per collection
SYNC_BATCH_SIZE=500
