# Node Environment
NODE_ENV=development

# HTTP port — frontend calls this
PORT=3000

# Keycloak (for local JWT validation via JWKS)
KEYCLOAK_SERVER_URL=http://localhost:8090
KEYCLOAK_REALM=inventory

# Downstream service URLs
KEYCLOAK_SERVICE_GRPC_URL=localhost:50051
BACKEND_HTTP_URL=http://localhost:3001
