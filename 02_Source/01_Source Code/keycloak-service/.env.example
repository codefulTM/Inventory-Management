# Node Environment
NODE_ENV=development

# HTTP port for direct health-check access
PORT=3002

# gRPC port
GRPC_PORT=50051

# MongoDB
MONGODB_URI=mongodb://localhost:27017/inventory

# Keycloak
KEYCLOAK_SERVER_URL=http://localhost:8090
KEYCLOAK_REALM=inventory
KEYCLOAK_CLIENT_ID=inventory-backend
KEYCLOAK_CLIENT_SECRET=change-me-in-production
KEYCLOAK_ADMIN_CLIENT_ID=inventory-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-in-production

# Mail
MAIL_USER=noreply@example.com
MAIL_PASS=change-me

# Frontend URL (used in reset-password link)
FRONTEND_URL=http://localhost:5173
